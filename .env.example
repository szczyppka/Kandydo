# Skopiuj do .env i uzupełnij wartościami. Nigdy nie commituj .env (patrz .gitignore).

# --- Lokalny Docker (dev) — Postgres + MinIO, patrz docker-compose.yml ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Baza danych ---
# Lokalnie: connection string do kontenera Postgres z docker-compose.yml.
# Produkcyjnie (Neon): connection string z panelu Neon.
DATABASE_URL=

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Storage (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Płatności (kredyty, tryb "użyj mojego klucza") ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Szyfrowanie kluczy API userów (BYOK) ---
ENCRYPTION_KEY=
